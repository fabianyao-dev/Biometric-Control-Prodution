# Copia este archivo a `.env` y ajusta los valores.
# El `.env` local esta en .gitignore; nunca se sube.

# --- Modbus TCP (PLC Zelio Logic 2 + modulo Ethernet SR3NET01BD) ---
# El CONTADOR de cortes vive en el PLC: la PC solo hace polling por red.
# Si dejas MODBUS_HOST vacio o pones MODBUS_SIMULACION=1, el sistema corre
# en modo simulacion (sin tocar red).
MODBUS_HOST=
MODBUS_PORT=502
MODBUS_UNIT_ID=1
MODBUS_SIMULACION=1

# Modo de escritura de los comandos:
#   registro = Zelio SR3NET01BD (FC06). El NET01BD NO expone coils: solo
#              4 palabras de ENTRADA J (dir 16-19, PC -> PLC) y 4 de SALIDA
#              O (dir 20-23, PLC -> PC). START y PAUSE son BITS dentro de
#              una palabra J.
#   coil     = modulo Advantech WISE-4060LAN (FC05, coils 16-19).
MODBUS_CMD_MODE=registro

# --- Comandos (modo "registro") ---
# J1 = dir 16, J2 = 17, J3 = 18, J4 = 19 (0-based, como pyModbusTCP).
# START y PAUSE pueden usar palabras distintas (J1 y J2) o la misma con
# bits distintos (p. ej. J1 bit0 = START, J1 bit1 = PAUSE).
MODBUS_START_REGISTER=16
MODBUS_START_BIT=0
MODBUS_PAUSE_REGISTER=17
MODBUS_PAUSE_BIT=0

# --- Comandos (modo "coil"; solo para el modulo Advantech) ---
MODBUS_START_COIL=16
MODBUS_PAUSE_COIL=17

# --- Contador de cortes (lo publica el PLC en las palabras O) ---
# Modo "registro": se lee de las palabras O (dir 20-23); O1 = dir 20.
# MEDIDO en el PLC real: el contador esta en O1 y es de 16 bits. O2 NO es la
# palabra alta del contador: es la palabra de PULSOS del PLC (se enciende un
# instante en cada corte y se apaga solo). Por eso se lee SOLO O1: con 2
# palabras el valor sale +65536 en cada pulso, el HAL lo descarta y se pierden
# cortes. Con 1 palabra el delta es limpio y el wrap a 65535 lo resuelve el HAL.
MODBUS_COUNTER_REGISTER=20
MODBUS_COUNTER_WORDS=1
# 1 = little-endian (palabra baja primero: O1=baja, O2=alta); 0 = big-endian.
# Solo aplica si se leen 2 palabras (MODBUS_COUNTER_WORDS=2).
MODBUS_COUNTER_LITTLE_ENDIAN=1

# Polaridad de cada senal (START pulso / PAUSE latch), igual en los dos modos.
# 0 (default): el pulso activo es True (rele energizado/contacto cerrado) y
#              el reposo es False. Para botones NA en paralelo al rele.
# 1: pulso invertido: activo = False (contacto abierto) y reposo = True.
#              Usar si la maquina actua cuando el circuito se ABRE (boton NA
#              en serie o logica NC). Ajusta solo la senal que lo requiera.
MODBUS_START_COIL_INVERTIDO=0
MODBUS_PAUSE_COIL_INVERTIDO=0

# Sondeo del contador (ms), salto maximo aceptado como corte real y duracion
# del pulso de MARCHA (ms).
MODBUS_POLL_MS=500
MODBUS_COUNTER_MAX_DELTA=10000
PULSO_DURACION_MS=700

# --- Seguro anti-paro / anti-apagado ---
# Bloquea el boton PARO y el apagado si la maquina esta en marcha y se recibio
# un corte dentro de estos ultimos segundos (maquina sigue cortando).
SEGURO_PARO_SEGUNDOS=3

# --- Seguro anti-corrida (modo "Primera pieza") ---
# Si dentro de SEGURO_RAFAGA_SEGUNDOS entran mas de SEGURO_RAFAGA_CORTES
# cortes con el conteo suspendido, suena una alarma y pregunta si la maquina
# ya empezo a correr: al confirmar (Sí) y autorizar por huella, SOLO los
# cortes de esa ventana y posteriores se incorporan a la sesion (los hechos
# antes quedan como piezas de prueba descartadas). 0 = desactivado.
SEGURO_RAFAGA_SEGUNDOS=7
SEGURO_RAFAGA_CORTES=5

# --- Timeout del modo "Primera pieza" ---
# Pasado este tiempo (segundos) en el modo sin salir, la SALIDA (para iniciar
# produccion) exige autorizacion de un rol con `autorizar_paro`
# (supervisor/admin). La maquina no se apaga ni sale del modo sola; solo se
# endurece la autorizacion. 0 = desactivado. Default 900 (15 min).
PRIMERA_PIEZA_TIMEOUT_S=900

# --- Rutas ---
# Empaquetado: .env, planta_corte.db y logs/ viven en la carpeta de datos
# persistente, creada en la primera ejecucion (por defecto
# %USERPROFILE%\WTSControlData). Puedes cambiarla con BIOMETRICO_DIR_DATOS
# (variable de entorno del sistema). DB_PATH y LOG_DIR se generan solos ahi;
# solo definelos si quieres una ubicacion distinta.
# BIOMETRICO_DIR_DATOS=C:\WTSControlData
DB_PATH=
LOG_DIR=

# --- App ---
# 1 = kiosco pantalla completa (default); 0 = ventana normal.
BIOMETRICO_KIOSKO=1

# --- Actualizaciones por red (opcional) ---
# URL base del servidor de actualizaciones (p. ej. http://10.0.0.2:8080).
# Vacia = sin actualizaciones por red: el boton "Buscar actualizacion" no se
# muestra. El servidor se enciende SOLO cuando se publica una version nueva.
UPDATE_SOURCE=
# Timeout (segundos) de consultas/descargas al servidor de actualizaciones.
UPDATE_TIMEOUT_S=8
