# Copia este archivo a `.env` y ajusta los valores.
# El `.env` local esta en .gitignore; nunca se sube.

# --- Modbus TCP (modulo Advantech con contador interno) ---
# Si dejas MODBUS_HOST vacio o pones MODBUS_SIMULACION=1, el sistema corre
# en modo simulacion (sin tocar red).
MODBUS_HOST=
MODBUS_PORT=502
MODBUS_UNIT_ID=1
MODBUS_SIMULACION=1

# Direcciones Modbus del modulo (ajustar al modelo/plano del modulo real).
# WISE-4060LAN: reles (DO) en coils 16-19, contador ch0 en holding 0-1.
MODBUS_START_COIL=16
MODBUS_PAUSE_COIL=17
MODBUS_COUNTER_REGISTER=0
MODBUS_COUNTER_WORDS=2
# 1 = little-endian (palabra baja primero, WISE-4060LAN); 0 = big-endian.
MODBUS_COUNTER_LITTLE_ENDIAN=1

# Polaridad del pulso de cada coil.
# 0 (default): el pulso activo es True (rele energizado/contacto cerrado) y
#              el reposo es False. Para botones NA en paralelo al rele.
# 1: pulso invertido: activo = False (contacto abierto) y reposo = True.
#              Usar si la maquina actua cuando el circuito se ABRE (boton NA
#              en serie o logica NC). Ajusta solo el coil que lo requiera.
MODBUS_START_COIL_INVERTIDO=0
MODBUS_PAUSE_COIL_INVERTIDO=0

MODBUS_POLL_MS=500
MODBUS_COUNTER_MAX_DELTA=10000
PULSO_DURACION_MS=300

# --- Seguro anti-paro / anti-apagado ---
# Bloquea el boton PARO y el apagado si la maquina esta en marcha y se recibio
# un corte dentro de estos ultimos segundos (maquina sigue cortando).
SEGURO_PARO_SEGUNDOS=3

# --- Seguro anti-corrida (modo "Primera pieza") ---
# Si dentro de SEGURO_RAFAGA_SEGUNDOS entran mas de SEGURO_RAFAGA_CORTES
# cortes con el conteo suspendido, suena una alarma y pregunta si la maquina
# ya empezo a correr: al confirmar (Sí) y autorizar por huella, SOLO los
# cortes de esa ventana y posteriores se incorporan a la sesion (los hechos
# antes quedan como piezas de prueba descartadas). 0 = desactivado.
SEGURO_RAFAGA_SEGUNDOS=7
SEGURO_RAFAGA_CORTES=5

# --- Rutas ---
# Empaquetado: .env, planta_corte.db y logs/ viven en la carpeta de datos
# persistente, creada en la primera ejecucion (por defecto
# %USERPROFILE%\WTSControlData). Puedes cambiarla con BIOMETRICO_DIR_DATOS
# (variable de entorno del sistema). DB_PATH y LOG_DIR se generan solos ahi;
# solo definelos si quieres una ubicacion distinta.
# BIOMETRICO_DIR_DATOS=C:\WTSControlData
DB_PATH=
LOG_DIR=

# --- App ---
# 1 = kiosco pantalla completa (default); 0 = ventana normal.
BIOMETRICO_KIOSKO=1

# --- Actualizaciones por red (opcional) ---
# URL base del servidor de actualizaciones (p. ej. http://10.0.0.2:8080).
# Vacia = sin actualizaciones por red: el boton "Buscar actualizacion" no se
# muestra. El servidor se enciende SOLO cuando se publica una version nueva.
UPDATE_SOURCE=
# Timeout (segundos) de consultas/descargas al servidor de actualizaciones.
UPDATE_TIMEOUT_S=8
